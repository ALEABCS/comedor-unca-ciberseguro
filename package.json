{
  "name": "comedor-unca-ciberseguro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite --host 0.0.0.0 --open",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:repair-finance": "tsx server/db/repair-finance-migration.ts",
    "db:copy-legacy": "tsx server/db/copy-legacy-data.ts",
    "db:seed": "tsx server/db/seed.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.66.9",
    "@trpc/client": "^11.0.0",
    "@trpc/react-query": "^11.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.468.0",
    "mysql2": "^3.24.5",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2",
    "wouter": "^3.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/node": "^22.13.4",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "drizzle-kit": "^0.31.11",
    "postcss": "^8.5.1",
    "typescript": "~5.7.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "uuid": "^11.1.1"
  }
}
